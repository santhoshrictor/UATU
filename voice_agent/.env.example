# LiveKit Server Configuration (Cloud or local air-gapped livekit-server.exe)
LIVEKIT_URL=wss://<project-subdomain>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Gemini Realtime / Multimodal API Key (for online assistant & visual snapshot analysis)
GOOGLE_API_KEY=

# Agent Dispatch Identifier
AGENT_NAME=iris
GEMINI_MODEL=gemini-3.1-flash-live-preview
GEMINI_VOICE=Enceladus

# UATU FastAPI Backend Integration (Historical video search, camera telemetry & health)
UATU_BACKEND_URL=http://127.0.0.1:8000
